// Cloudflare Workers configuration — static assets only (no Worker code).
// Docs: https://developers.cloudflare.com/workers/static-assets/
// See docs/deployment.md for why Workers (and not Pages) and for the full setup.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "giovannimariarava-com",

  // Pins the Workers runtime behaviour to a known date. Bump deliberately, after
  // reading the compatibility-date changelog; do not leave it floating.
  "compatibility_date": "2026-10-09",

  "assets": {
    // Output folder of `astro build`. Everything here is served as-is.
    "directory": "./dist",

    // Serve /about for /about/ and vice-versa consistently with Astro's
    // `trailingSlash: 'never'` + `build.format: 'file'` output (about.html).
    "html_handling": "auto-trailing-slash",

    // Unknown paths return dist/404.html with a real HTTP 404 status.
    "not_found_handling": "404-page",
  },

  // The site lives ONLY on its own domain: no public *.workers.dev duplicate.
  "workers_dev": false,

  // DNS-affecting: on deploy, Cloudflare creates the DNS record and the certificate for this host.
  // Requires giovannimariarava.com to be a zone in the Cloudflare account, and NO conflicting
  // A/AAAA/CNAME record for the same name (MX records for Email Routing are unaffected).
  // `www` is intentionally not listed: redirect it to the apex with a Cloudflare Redirect Rule
  // (docs/environments.md) instead of serving a second copy of the site.
  "routes": [{ "pattern": "giovannimariarava.com", "custom_domain": true }],
}
