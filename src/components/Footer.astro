---
import { LAUNCH, SITE } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <p>
      © {year} {SITE.name}
    </p>
    <ul>
      {!LAUNCH && (
        <li>
          <a href="/privacy">Privacy</a>
        </li>
      )}
      {!LAUNCH && (
        <li>
          <a href="/writing/rss.xml">RSS</a>
        </li>
      )}
      <li>
        <a href="/.well-known/security.txt">security.txt</a>
      </li>
    </ul>
  </div>
</footer>
