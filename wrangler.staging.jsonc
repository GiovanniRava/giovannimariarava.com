// Cloudflare Workers configuration for the TEST environment (branch `develop`).
// Same static-assets setup as wrangler.jsonc, but a separate Worker: deploying here can never
// touch production. Used by .github/workflows/staging.yml via `wrangler deploy --config`.
// See docs/environments.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "giovannimariarava-com-staging",

  // Keep in sync with wrangler.jsonc, so test and production run the same runtime behaviour.
  "compatibility_date": "2026-10-09",

  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },

  // The test site lives ONLY on its own domain: no public *.workers.dev duplicate, and no need to
  // register a workers.dev subdomain on the account.
  "workers_dev": false,

  // DNS-affecting: on deploy, Cloudflare creates the DNS record and the certificate for this host.
  // Requires giovannimariarava.com to be a zone in the Cloudflare account, and NO existing DNS
  // record named `test` (a Custom Domain cannot replace one). See docs/environments.md.
  "routes": [{ "pattern": "test.giovannimariarava.com", "custom_domain": true }],
}
